# and operational detail. Never commit (this is a public repo).
bot.log
bot.log.*

# Live-trading mutex (transient)
.real-mode.lock

# Bearer token for the local API. Per-install, regenerated if deleted.
.api-token

# Helius / PumpPortal keys saved from UI Settings. Per-install credentials.
.api-keys.json

# Per-machine feature flag state (toggled via /api/flags)
flags.json

# Copy-trader runtime state (tracked wallets, open copy positions)
.copy-trader.json
